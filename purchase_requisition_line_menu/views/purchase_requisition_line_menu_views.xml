<odoo>

    <record id="purchase_requisition_line_menu_search" model="ir.ui.view">
        <field name="name">purchase.requisition.line.menu.search</field>
        <field name="model">purchase.requisition.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="requisition_id" />
                <field name="product_id" />
                <separator />
                <filter
                    string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"
                    help="New Agreements"
                />
                <filter
                    string="Confirmed"
                    name="confirmed"
                    domain="[('state', 'in', ('in_progress', 'open', 'ongoing'))]"
                    help="In negotiation"
                />
                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <group expand="0" string="Group By">
                    <filter
                        string="Purchase Requisition"
                        name="requisition_id"
                        domain="[]"
                        context="{'group_by': 'requisition_id'}"
                    />
                    <filter
                        string="Product"
                        name="product_id"
                        domain="[]"
                        context="{'group_by': 'product_id'}"
                    />
                    <filter
                        string="Schedule Date"
                        name="schedule_date"
                        domain="[]"
                        context="{'group_by': 'schedule_date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="purchase_requisition_line_menu_tree" model="ir.ui.view">
        <field name="name">purchase.requisition.line.menu.tree</field>
        <field name="model">purchase.requisition.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="requisition_id" />
                <field name="product_id" domain="[('purchase_ok', '=', True)]" />
                <field
                    name="product_description_variants"
                    attrs="{'invisible': [('product_description_variants', '=', '')], 'readonly': [('state', '!=', 'draft')]}"
                />
                <field name="product_qty" />
                <field name="qty_ordered" optional="show" />
                <field name="product_uom_category_id" invisible="1" />
                <field
                    name="product_uom_id"
                    string="UoM"
                    groups="uom.group_uom"
                    optional="show"
                    attrs="{'required': [('product_id', '!=', False)]}"
                />
                <field name="schedule_date" optional="show" />
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    optional="hide"
                    groups="analytic.group_analytic_accounting"
                    options="{'product_field': 'product_id', 'business_domain': 'purchase_order'}"
                />
                <field name="price_unit" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    invisible="1"
                    optional="hide"
                    options="{'no_create': True}"
                />
                <field
                    name="state"
                    optional="show"
                    widget="badge"
                    decoration-success="state == 'done'"
                    decoration-info="state not in ('done', 'cancel')"
                />
            </tree>
        </field>
    </record>

    <record id="purchase_requisition_line_menu_action" model="ir.actions.act_window">
        <field name="name">Blanket Orders Line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.requisition.line</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="purchase_requisition_line_menu_search" />
    </record>

    <menuitem
        id="purchase_requisition_line_menu_menu"
        sequence="11"
        parent="purchase.menu_procurement_management"
        action="purchase_requisition_line_menu_action"
    />

</odoo>
