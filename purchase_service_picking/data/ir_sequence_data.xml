<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="sequence_service_picking" model="ir.sequence">
        <field name="name">Service picking</field>
        <field name="code">service.picking</field>
        <field name="prefix">SP/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False" />
    </record>
     <record id="sequence_service_picking_return" model="ir.sequence">
        <field name="name">Service picking return</field>
        <field name="code">service.picking.return</field>
        <field name="prefix">SPR/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False" />
    </record>
</odoo>
