<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="act_service_return_picking" model="ir.actions.act_window">
        <field name="name">Reverse Service Picking</field>
        <field name="res_model">service.return.picking</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_service_return_picking_form" model="ir.ui.view">
        <field name="name">Return lines</field>
        <field name="model">service.return.picking</field>
        <field name="arch" type="xml">
            <form>
                <!-- <field name="move_dest_exists" invisible="1"/> -->
                <field name="picking_id" invisible="1" force_save="1" />
                <group>
                    <field name="product_return_lines" nolabel="1">
                        <tree editable="top" create="0">
                            <field
                                name="product_id"
                                options="{'no_create': True, 'no_open': True}"
                                force_save="1"
                            />
                            <field name="quantity" />
                            <field name="uom_id" readonly="1" groups="uom.group_uom" />
                            <field name="line_id" invisible="1" />
                        </tree>
                    </field>
                </group>
                <footer>
                    <button
                        name="create_returns"
                        string="Return"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
