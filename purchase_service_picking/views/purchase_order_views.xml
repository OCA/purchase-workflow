<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_view_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_rfq_send']" position="after">
                <button
                    name="action_view_service_picking"
                    string="Receive Services"
                    class="oe_highlight"
                    type="object"
                    attrs="{'invisible': ['|', '|' , ('is_service_shipped', '=', True), ('state','not in', ('purchase','done')), ('service_picking_count', '=', 0)]}"
                />
            </xpath>
            <field name="partner_id" position="after">
                <field name="is_service_shipped" invisible="1" />
            </field>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    type="object"
                    name="action_view_service_picking"
                    class="oe_stat_button"
                    icon="fa-cogs"
                    attrs="{'invisible':[('service_picking_ids','=',[])]}"
                >
                    <field
                        name="service_picking_count"
                        widget="statinfo"
                        string="Service Picking"
                    />
                    <field name="service_picking_ids" invisible="1" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
