<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="service_picking_rule" model="ir.rule">
        <field name="name">service_picking multi-company</field>
        <field name="model_id" ref="model_service_picking" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="service_picking_line_rule" model="ir.rule">
        <field name="name">service_picking_line multi-company</field>
        <field name="model_id" ref="model_service_picking_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
     </record>
</odoo>
