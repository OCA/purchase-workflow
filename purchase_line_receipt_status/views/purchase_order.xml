<odoo>

    <record id="purchase_order_form_view" model="ir.ui.view">
        <field name="model">purchase.order</field>
        <field
            name="inherit_id"
            ref="purchase_stock.purchase_order_view_form_inherit"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/tree//field[@name='state']"
                position="before"
            >
                <field
                    name="line_receipt_status"
                    optional="hide"
                    widget="badge"
                    decoration-info="line_receipt_status == 'pending'"
                    decoration-warning="line_receipt_status == 'partial'"
                    decoration-success="line_receipt_status == 'full'"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='date_planned']"
                position="after"
            >
                <field name="line_receipt_status" states="purchase,done" />
            </xpath>
        </field>
    </record>

</odoo>
