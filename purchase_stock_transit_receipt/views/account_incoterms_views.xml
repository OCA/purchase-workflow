<odoo>
    <record id="view_incoterms_tree" model="ir.ui.view">
        <field name="model">account.incoterms</field>
        <field name="inherit_id" ref="account.view_incoterms_tree" />
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="transit_receipt" />
            </field>
        </field>
    </record>
    <record id="account_incoterms_form" model="ir.ui.view">
        <field name="model">account.incoterms</field>
        <field name="inherit_id" ref="account.account_incoterms_form" />
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="transit_receipt" />
            </field>
        </field>
    </record>
</odoo>
