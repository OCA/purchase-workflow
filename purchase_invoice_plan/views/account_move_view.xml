<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.purchase.invoice.plan</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="purchase.view_move_form_inherit_purchase" />
        <field name="arch" type="xml">
            <field name="purchase_vendor_bill_id" position="after">
                <field
                    name="purchase_invoice_plan_ids"
                    widget="many2many_tags"
                    readonly="1"
                    invisible="move_type != 'in_invoice' or not purchase_invoice_plan_ids"
                />
            </field>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='purchase_line_id']"
                position="after"
            >
                <field
                    name="purchase_order_id"
                    groups="purchase.group_purchase_user"
                    column_invisible="1"
                />
                <field
                    name="purchase_invoice_plan_id"
                    groups="purchase.group_purchase_user"
                    column_invisible="parent.move_type != 'in_invoice'"
                    optional="hide"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
