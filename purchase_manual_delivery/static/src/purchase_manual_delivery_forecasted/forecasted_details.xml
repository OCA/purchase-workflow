<?xml version="1.0" encoding="utf-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="purchase_manual_delivery.ForecastedDetails"
        t-inherit="stock.ForecastedDetails"
        t-inherit-mode="extension"
    >
        <xpath expr="//tr[@name='draft_po_in']" position="after">
            <tr
                t-if="currentProduct.no_delivery_purchase_qty.in"
                name="no_delivery_in"
                t-attf-class="#{multipleProducts and 'collapse show' or ''} collapseGroup_#{line.product.id}"
            >
                <td />
                <td>Requests without delivery :
                    <t
                    t-foreach="currentProduct.no_delivery_purchase_orders"
                    t-as="purchase_order"
                    t-key="purchase_order_index"
                >
                    <t t-if="purchase_order_index > 0"> | </t>
                    <a
                        t-attf-href="#"
                        t-out="purchase_order.name"
                        class="fw-bold"
                        t-on-click.prevent="() => this.props.openView('purchase.order', 'form', purchase_order.id)"
                    />
                </t>
                </td>
                <td class="text-end text-success">
                    <t
                        t-out="_formatFloat(currentProduct.no_delivery_purchase_qty.in)"
                    />
                    <t t-out="line.uom_id.display_name" />
                </td>
            </tr>
        </xpath>
    </t>
</templates>
