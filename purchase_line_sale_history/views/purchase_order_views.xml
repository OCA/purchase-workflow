<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form - purchase_line_sale_history</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list/field[@name='product_qty']"
                position="after"
            >
                <field
                    name="show_sales_history"
                    widget="boolean_toggle"
                    options="{'autosave': False}"
                    optional="show"
                />
            </xpath>
            <xpath expr="//field[@name='order_line']" position="after">
                <field name="sales_history_line_id" invisible="1" />
                <field
                    name="sales_history_data"
                    widget="purchase_sales_history"
                    nolabel="1"
                />
            </xpath>
        </field>
    </record>
</odoo>
