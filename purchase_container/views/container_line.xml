<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <!-- Container Line Views -->
    <record id="container_line_view_form" model="ir.ui.view">
        <field name="model">container.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Product Information">
                            <field name="container_id" />
                            <field name="product_id" />
                            <field name="description" />
                            <field name="purchase_line_id" />
                            <field name="purchase_order_id" />
                        </group>
                        <group string="Quantities">
                            <label for="quantity" />
                            <div class="o_row">
                                <field name="quantity" />
                                <field
                                    name="product_uom_id"
                                    options="{'no_open': True, 'no_create': True}"
                                />
                                <field name="product_uom_category_id" invisible="1" />
                            </div>
                            <field name="carton_qty" />
                            <field name="units_per_carton" />
                        </group>
                    </group>
                    <group>
                        <group string="Dimensions">
                            <field name="weight" />
                            <field name="volume" />
                        </group>
                        <group string="Cost">
                            <field name="landed_cost" />
                            <field name="currency_id" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="container_line_view_list" model="ir.ui.view">
        <field name="model">container.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="container_id" optional="hide" />
                <field name="product_id" />
                <field name="quantity" />
                <field
                    name="product_uom_id"
                    options="{'no_open': True, 'no_create': True}"
                />
                <field name="product_uom_category_id" invisible="1" />
                <field name="carton_qty" optional="show" />
                <field name="units_per_carton" optional="show" />
                <field name="weight" optional="hide" />
                <field name="volume" optional="hide" />
                <field name="purchase_order_id" optional="hide" />
                <field name="landed_cost" optional="hide" />
                <field name="currency_id" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="container_line_view_search" model="ir.ui.view">
        <field name="model">container.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="container_id" />
                <field name="product_id" />
                <field name="purchase_order_id" />
                <separator />
                <group expand="0" name="group_by" string="Group By">
                    <filter
                        name="group_container"
                        string="Container"
                        context="{'group_by': 'container_id'}"
                    />
                    <filter
                        name="group_product"
                        string="Product"
                        context="{'group_by': 'product_id'}"
                    />
                    <filter
                        name="group_po"
                        string="Purchase Order"
                        context="{'group_by': 'purchase_order_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="container_line_action" model="ir.actions.act_window">
        <field name="name">Container Lines</field>
        <field name="res_model">container.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_container': 1}</field>
    </record>
</odoo>
