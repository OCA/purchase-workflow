<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="purchase_container_view_form" model="ir.ui.view">
        <field name="model">purchase.container</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="in_progress,pos_confirmed,on_water,arrival_notice,released,delivered,received,processed"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_rfq"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-shopping-cart"
                            attrs="{'invisible': [('purchase_order_rfq_count', '=', 0)]}"
                        >
                            <field
                                name="purchase_order_rfq_count"
                                widget="statinfo"
                                string="RFQ"
                            />
                        </button>
                        <button
                            name="action_view_order"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-credit-card"
                            attrs="{'invisible': [('purchase_order_count', '=', 0)]}"
                        >
                            <field
                                name="purchase_order_count"
                                widget="statinfo"
                                string="Purchases"
                            />
                        </button>
                        <button
                            name="action_view_picking"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-truck"
                            attrs="{'invisible': [('picking_count', '=', 0)]}"
                        >
                            <field
                                name="picking_count"
                                widget="statinfo"
                                string="Transfers"
                            />
                        </button>
                        <button
                            name="action_view_documents"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                        >
                            <field
                                name="document_count"
                                widget="statinfo"
                                string="Documents"
                            />
                        </button>
                        <button
                            name="action_view_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                            attrs="{'invisible': [('line_count', '=', 0)]}"
                        >
                            <field name="line_count" widget="statinfo" string="Lines" />
                        </button>
                        <button
                            name="action_view_landed_costs"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-usd"
                            attrs="{'invisible': [('landed_cost_count', '=', 0)]}"
                        >
                            <field
                                name="landed_cost_count"
                                widget="statinfo"
                                string="Landed Costs"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Locked"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('is_locked', '=', False)]}"
                    />
                    <div class="oe_title">
                        <label for="name" string="Container" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group name="container_info" string="Container Information">
                            <field name="code" placeholder="Container Reference" />
                            <field name="seal_number" />
                            <field name="type_id" />
                            <field name="bill_of_lading_ref" />
                        </group>
                        <group name="shipping_info" string="Shipping">
                            <field name="shipping_agent_id" />
                            <field
                                name="freight_forwarder_ref"
                                placeholder="e.g., B00064516"
                            />
                            <field name="drayage_company_id" />
                            <field name="displayed_incoterm_id" />
                            <field name="incoterm_id" invisible="1" />
                            <field name="warehouse_id" />
                        </group>
                    </group>
                    <notebook>
                        <page name="dates" string="Dates &amp; Locations">
                            <group>
                                <group string="Departure">
                                    <field name="departure_location_id" />
                                    <field name="date_etd" />
                                    <field name="date_atd" />
                                </group>
                                <group string="Port Arrival">
                                    <field name="arrival_location_id" />
                                    <field name="date_eta" />
                                    <field name="date_ata" />
                                    <field name="date_ett" />
                                </group>
                            </group>
                            <group>
                                <group string="Warehouse Delivery">
                                    <field name="date_warehouse_eta" />
                                    <field name="date_delivered" />
                                    <field name="date_received" />
                                </group>
                            </group>
                        </page>
                        <page name="financials" string="Costs">
                            <group>
                                <group name="costs" string="Ocean Freight">
                                    <label for="cost" />
                                    <div class="o_row" name="container_cost">
                                        <field name="cost" />
                                        <field
                                            name="cost_currency_id"
                                            options="{'no_open': True, 'no_create': True}"
                                        />
                                    </div>
                                    <field name="has_additional_fees" />
                                    <field
                                        name="per_diem_fees"
                                        attrs="{'invisible': [('has_additional_fees', '=', False)]}"
                                    />
                                    <field
                                        name="per_diem_reason"
                                        attrs="{'invisible': [('has_additional_fees', '=', False)]}"
                                    />
                                </group>
                                <group name="landed_costs" string="Landed Costs">
                                    <field name="total_landed_cost" />
                                    <field
                                        name="landed_cost_ids"
                                        widget="many2many_tags"
                                    />
                                    <button
                                        name="action_create_landed_cost"
                                        type="object"
                                        string="Create Landed Cost"
                                        class="btn-secondary"
                                        attrs="{'invisible': [('picking_count', '=', 0)]}"
                                    />
                                </group>
                            </group>
                            <group>
                                <group name="metrics" string="Metrics">
                                    <field name="package_qty" />
                                    <label for="weight" />
                                    <div class="o_row" name="weight">
                                        <field name="weight" />
                                        <field
                                            name="weight_uom_id"
                                            options="{'no_open': True, 'no_create': True}"
                                        />
                                    </div>
                                    <label for="volume" />
                                    <div class="o_row" name="volume">
                                        <field name="volume" string="Volume" />
                                        <field
                                            name="volume_uom_id"
                                            options="{'no_open': True, 'no_create': True}"
                                        />
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page name="purchase_orders" string="Purchase Orders">
                            <field
                                name="purchase_order_ids"
                                nolabel="1"
                                attrs="{'readonly': [('is_locked', '=', True)]}"
                            >
                                <tree>
                                    <field name="name" />
                                    <field name="partner_id" />
                                    <field name="date_order" />
                                    <field name="amount_total" />
                                    <field name="state" />
                                </tree>
                            </field>
                        </page>
                        <page name="receipts" string="Receipts">
                            <field
                                name="picking_ids"
                                nolabel="1"
                                widget="many2many"
                                context="{'search_default_draft': 1, 'search_default_waiting': 1, 'search_default_available': 1}"
                            >
                                <tree>
                                    <field name="name" />
                                    <field name="partner_id" />
                                    <field name="scheduled_date" />
                                    <field name="state" />
                                </tree>
                            </field>
                        </page>
                        <page name="tracking" string="Shipment Tracking">
                            <group>
                                <group string="Carrier Information">
                                    <field name="carrier_id" />
                                    <field name="vessel_name" />
                                    <field name="voyage_number" />
                                </group>
                                <group string="Tracking">
                                    <field name="tracking_number" />
                                    <field name="tracking_url" widget="url" />
                                    <button
                                        name="action_open_tracking"
                                        type="object"
                                        string="Open Tracking"
                                        icon="fa-external-link"
                                        class="oe_link"
                                        attrs="{'invisible': [('tracking_url', '=', False)]}"
                                    />
                                </group>
                            </group>
                            <group>
                                <group string="Status">
                                    <field name="tracking_status" />
                                    <field name="last_tracking_update" />
                                </group>
                            </group>
                        </page>
                        <page name="lines" string="Container Lines">
                            <field
                                name="line_ids"
                                nolabel="1"
                                context="{'default_container_id': id}"
                            >
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="product_id" />
                                    <field name="quantity" />
                                    <field
                                        name="product_uom_id"
                                        options="{'no_open': True, 'no_create': True}"
                                    />
                                    <field
                                        name="product_uom_category_id"
                                        invisible="1"
                                    />
                                    <field name="carton_qty" optional="show" />
                                    <field name="units_per_carton" optional="show" />
                                    <field
                                        name="weight"
                                        optional="hide"
                                        sum="Total Weight"
                                    />
                                    <field
                                        name="volume"
                                        optional="hide"
                                        sum="Total Volume"
                                    />
                                    <field name="purchase_order_id" optional="hide" />
                                </tree>
                            </field>
                        </page>
                        <page name="documents" string="Documents">
                            <div
                                class="alert alert-warning"
                                role="alert"
                                attrs="{'invisible': [('documents_complete', '=', True)]}"
                            >
                                <strong
                                >Warning:</strong> Some required documents are missing or not yet approved.
                            </div>
                            <button
                                name="action_create_required_documents"
                                type="object"
                                string="Create Required Documents"
                                class="btn-secondary mb-3"
                            />
                            <field
                                name="document_ids"
                                nolabel="1"
                                context="{'default_container_id': id}"
                            >
                                <tree
                                    decoration-danger="state == 'rejected'"
                                    decoration-warning="state == 'missing' and required"
                                    decoration-success="state == 'approved'"
                                >
                                    <field name="document_type_id" />
                                    <field name="required" />
                                    <field name="reference" />
                                    <field name="attachment_id" />
                                    <field name="date_received" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-danger="state == 'rejected'"
                                        decoration-warning="state == 'missing'"
                                        decoration-info="state == 'pending'"
                                        decoration-success="state == 'approved'"
                                    />
                                </tree>
                            </field>
                            <field name="documents_complete" invisible="1" />
                        </page>
                        <page name="notes" string="Notes">
                            <field
                                name="notes"
                                nolabel="1"
                                placeholder="Internal notes..."
                            />
                        </page>
                    </notebook>
                    <field name="is_locked" invisible="1" />
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="purchase_container_view_list" model="ir.ui.view">
        <field name="model">purchase.container</field>
        <field name="arch" type="xml">
            <tree decoration-danger="documents_complete == False">
                <field name="code" />
                <field name="freight_forwarder_ref" optional="show" />
                <field name="seal_number" optional="hide" />
                <field name="type_id" />
                <field name="bill_of_lading_ref" optional="hide" />
                <field name="carrier_id" optional="hide" />
                <field name="vessel_name" optional="hide" />
                <field name="tracking_number" optional="hide" />
                <field name="shipping_agent_id" />
                <field name="drayage_company_id" optional="hide" />
                <field name="warehouse_id" />
                <field name="date_etd" optional="hide" />
                <field name="date_eta" />
                <field name="date_warehouse_eta" />
                <field name="purchase_order_ids" widget="many2many_tags" />
                <field name="documents_complete" optional="hide" widget="boolean" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'in_progress'"
                    decoration-warning="state in ('customs_hold', 'on_hold')"
                    decoration-success="state in ('received', 'processed')"
                />
            </tree>
        </field>
    </record>

    <record id="purchase_container_view_search" model="ir.ui.view">
        <field name="model">purchase.container</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="freight_forwarder_ref" />
                <field name="seal_number" />
                <field name="tracking_number" />
                <field name="vessel_name" />
                <field name="picking_ids" />
                <field name="purchase_order_ids" />
                <field name="bill_of_lading_ref" />
                <field name="warehouse_id" />
                <field name="carrier_id" />
                <separator />
                <filter
                    name="in_progress"
                    string="In Progress"
                    domain="[('state', '=', 'in_progress')]"
                />
                <filter
                    name="on_water"
                    string="On the Water"
                    domain="[('state', '=', 'on_water')]"
                />
                <filter
                    name="arrival_notice"
                    string="Arrival Notice"
                    domain="[('state', '=', 'arrival_notice')]"
                />
                <filter
                    name="customs_hold"
                    string="Customs Hold"
                    domain="[('state', '=', 'customs_hold')]"
                />
                <filter
                    name="delivered"
                    string="Delivered"
                    domain="[('state', '=', 'delivered')]"
                />
                <filter
                    name="received"
                    string="Received"
                    domain="[('state', '=', 'received')]"
                />
                <filter
                    name="on_hold"
                    string="On Hold"
                    domain="[('state', '=', 'on_hold')]"
                />
                <separator />
                <filter
                    name="missing_documents"
                    string="Missing Documents"
                    domain="[('documents_complete', '=', False)]"
                />
                <separator />
                <group expand="0" name="group_by" string="Group By">
                    <filter
                        name="group_state"
                        string="State"
                        domain="[]"
                        context="{'group_by' : 'state'}"
                    />
                    <filter
                        name="group_warehouse"
                        string="Warehouse"
                        domain="[]"
                        context="{'group_by' : 'warehouse_id'}"
                    />
                    <filter
                        name="group_shipping_agent"
                        string="Freight Forwarder"
                        domain="[]"
                        context="{'group_by' : 'shipping_agent_id'}"
                    />
                    <filter
                        name="group_drayage"
                        string="Drayage Company"
                        domain="[]"
                        context="{'group_by' : 'drayage_company_id'}"
                    />
                    <filter
                        name="group_type"
                        string="Container Type"
                        domain="[]"
                        context="{'group_by' : 'type_id'}"
                    />
                    <filter
                        name="group_eta"
                        string="Port ETA"
                        domain="[]"
                        context="{'group_by' : 'date_eta'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="purchase_container_action" model="ir.actions.act_window">
        <field name="name">Containers</field>
        <field name="res_model">purchase.container</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <menuitem
        id="menu_procurement_management_container"
        parent="purchase.menu_procurement_management"
        action="purchase_container_action"
    />
</odoo>
