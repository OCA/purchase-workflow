<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase_order</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='matrix_setting_container']" position="after">
                <block title="Auto Follow" name="autofollow_settings_container">
                    <setting
                        id="partner_disable_autofollow_setting"
                        help="Do not auto-subscribe customer to purchase orders."
                    >
                        <field name="purchase_partner_disable_autofollow" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
