<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--  This view is used in picking operations  -->
    <record id="view_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom']"
                position="after"
            >
                <field
                    name="is_purchase_price_editable"
                    column_invisible="1"
                    groups="purchase.group_purchase_user"
                />
                <field
                    name="purchase_price_unit"
                    optional="hide"
                    column_invisible="parent.picking_type_code != 'incoming'"
                    invisible="not purchase_line_id"
                    readonly="not is_purchase_price_editable"
                    groups="purchase.group_purchase_user"
                />
            </xpath>
        </field>
    </record>

    <!--  This view is used in picking detailed operations  -->
    <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field
                    name="is_purchase_price_editable"
                    column_invisible="1"
                    groups="purchase.group_purchase_user"
                />
                <field
                    name="purchase_price_unit"
                    optional="hide"
                    column_invisible="picking_code != 'incoming'"
                    invisible="not purchase_line_id"
                    readonly="not is_purchase_price_editable"
                    groups="purchase.group_purchase_user"
                />
            </xpath>
        </field>
    </record>
</odoo>
