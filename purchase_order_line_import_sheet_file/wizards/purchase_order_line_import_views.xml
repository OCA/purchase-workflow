<odoo>
    <record id="purchase_order_line_import_view_form" model="ir.ui.view">
        <field name="name">purchase.order.line.import.form</field>
        <field name="model">purchase.order.line.import</field>
        <field name="arch" type="xml">
            <form string="Import Lines">
                <field name="order_id" invisible="1" />
                <p>
                    Upload a spreadsheet whose first row holds the column names of
                    the template. Each following row adds a line to the request for
                    quotation. If any row has an error, no line is imported.
                </p>
                <div class="mb-4">
                    <button
                        name="action_download_template"
                        type="object"
                        string="Download Template"
                        icon="fa-download"
                        class="btn-link ps-0"
                    />
                </div>
                <group>
                    <field name="file" filename="file_name" />
                    <field name="file_name" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                        invisible="not file"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="purchase_order_line_import_action" model="ir.actions.act_window">
        <field name="name">Import Lines</field>
        <field name="res_model">purchase.order.line.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
