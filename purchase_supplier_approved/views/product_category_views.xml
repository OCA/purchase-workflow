<odoo>

    <!-- Inherit Product Category Form View -->
    <record id="view_product_category_form_inherit" model="ir.ui.view">
        <field name="name">product.category.form.inherit.approved.suppliers</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field
                    name="require_approved_supplier"
                    groups="purchase_supplier_approved.group_manage_approved_suppliers"
                />
            </xpath>
        </field>
    </record>

</odoo>
