<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_company_invoice_address">
        <div class="mt-3">
            <strong>Invoice address:</strong>
            <div>
                <span t-field="o.company_invoice_address_id.name" />
                <div
                    t-field="o.company_invoice_address_id"
                    t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'
                />
            </div>
        </div>
    </template>
    <template
        id="report_purchaseorder_document"
        inherit_id="purchase.report_purchaseorder_document"
    >
        <xpath expr="//div[hasclass('page')]" position="before">
            <!-- The company address is already in the report header, so only an
                 address that differs from it is worth printing. Keeping the
                 t-set inside the condition also leaves information_block unset
                 when there is nothing to add, which would otherwise render as
                 an empty column next to the vendor address. -->
            <t
                t-if="o.company_invoice_address_id and o.company_invoice_address_id != o.company_partner_id"
            >
                <t t-set="information_block">
                    <t t-out="information_block or ''" />
                    <t
                        t-call="purchase_company_invoice_address.report_company_invoice_address"
                    />
                </t>
            </t>
        </xpath>
    </template>
</odoo>
