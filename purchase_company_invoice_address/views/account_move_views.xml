<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.view.form.company.invoice.address</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="partner_shipping_id" position="after">
                <field name="company_partner_id" invisible="1" />
                <field
                    name="company_invoice_address_id"
                    attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund'))], 'readonly': [('state', '!=', 'draft')]}"
                />
            </field>
        </field>
    </record>
</odoo>
