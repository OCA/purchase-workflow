<odoo>
    <!-- Unit price: add UoM and secondary price ('secondary' and 'both' modes) -->
    <template id="purchase_uom_price">
        <t t-if="line.report_show_price_uom('primary_uom')">
            / <span t-field="line.product_uom.name" groups="uom.group_uom" />
        </t>
        <t t-if="line.get_secondary_uom_display_mode() == 'secondary'">
            <span t-field="line.secondary_uom_price" />
            <t t-if="line.report_show_price_uom()">
                / <span t-field="line.secondary_uom_id.name" groups="uom.group_uom" />
            </t>
        </t>
        <t t-if="line.get_secondary_uom_display_mode() == 'both'">
            <br />
            <span class="text-muted">
                (<span t-field="line.secondary_uom_price" />
                / <span t-field="line.secondary_uom_id.name" groups="uom.group_uom" />)
            </span>
        </t>
    </template>
    <template
        id="purchase_order_portal_content_secondary_uom"
        inherit_id="purchase.purchase_order_portal_content"
    >
        <xpath
            expr="//table[@id='purchase_order_table']//thead//th[normalize-space()='Quantity']"
            position="before"
        >
            <th
                class="text-end"
                t-if="not order.company_id.hide_secondary_uom_column(order)"
            >
                <strong>Second Qty</strong>
            </th>
        </xpath>
        <xpath expr="//td[@id='product_name']" position="after">
            <td
                class="text-end"
                t-if="not order.company_id.hide_secondary_uom_column(order)"
            >
                <span t-field="line.secondary_uom_qty" />
                <span t-field="line.secondary_uom_id.name" groups="uom.group_uom" />
            </td>
        </xpath>
        <!-- Quantity: hide primary when secondary is prioritized -->
        <xpath
            expr="//div[@id='quote_qty']/span[@t-field='line.product_qty']"
            position="attributes"
        >
            <attribute
                name="t-if"
            >line.get_secondary_uom_display_mode() != 'secondary'</attribute>
        </xpath>
        <xpath
            expr="//div[@id='quote_qty']/span[@t-field='line.product_uom']"
            position="attributes"
        >
            <attribute
                name="t-if"
            >line.get_secondary_uom_display_mode() != 'secondary'</attribute>
        </xpath>
        <!-- Quantity: add secondary qty ('secondary' mode) -->
        <xpath expr="//div[@id='quote_qty']" position="inside">
            <t t-if="line.get_secondary_uom_display_mode() == 'secondary'">
                <span t-field="line.secondary_uom_qty" />
                <span t-field="line.secondary_uom_id.name" groups="uom.group_uom" />
            </t>
        </xpath>
        <!-- Quantity: add secondary qty ('both' mode) -->
        <xpath expr="//div[@id='quote_qty']" position="inside">
            <t t-if="line.get_secondary_uom_display_mode() == 'both'">
                <br />
                <span class="text-muted">
                    (<span t-field="line.secondary_uom_qty" />
                    <span
                    t-field="line.secondary_uom_id.name"
                    groups="uom.group_uom"
                />)
                </span>
            </t>
        </xpath>
        <xpath
            expr="//td[@t-if='display_price_and_taxes']//div[@t-field='line.price_unit']"
            position="attributes"
        >
            <attribute name="class">text-end d-inline</attribute>
            <attribute
                name="t-if"
            >line.get_secondary_uom_display_mode() != 'secondary'</attribute>
        </xpath>
        <xpath expr="//div[@t-field='line.price_unit']" position="after">
            <t t-call="purchase_order_secondary_unit.purchase_uom_price" />
        </xpath>
    </template>
</odoo>
