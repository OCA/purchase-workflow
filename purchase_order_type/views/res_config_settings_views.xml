<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_purchase" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase.res_config_settings_view_form_purchase"
        />
        <field name="arch" type="xml">
            <div id="automatic_lock_confirmed_orders" position="after">
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    id="purchase_order_type_required"
                >
                    <div class="o_setting_left_pane">
                        <field name="purchase_order_type_required" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="purchase_order_type_required" />
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            aria-label="Values set here are company-specific."
                            groups="base.group_multi_company"
                            role="img"
                        />
                        <div class="text-muted">
                            Purchase orders can only be saved once they have an order type
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
