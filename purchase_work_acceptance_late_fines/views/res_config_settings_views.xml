<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_purchase" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="27" />
        <field
            name="inherit_id"
            ref="purchase.res_config_settings_view_form_purchase"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='purchase_work_acceptance_setting_container']"
                position="inside"
            >
                <setting id="enable_fines_on_wa">
                    <field name="group_enable_fines_on_wa" class="o_light_label" />
                    <div class="content-group" invisible="not group_enable_fines_on_wa">
                        <div class="row mt16">
                            <label
                                for="wa_fines_late_account_id"
                                class="col-lg-4 o_light_label"
                            />
                            <field
                                name="wa_fines_late_account_id"
                                required="group_enable_fines_on_wa"
                            />
                        </div>
                        <div class="row mt16">
                            <label for="wa_fines_rate" class="col-lg-4 o_light_label" />
                            <div>
                                <field
                                name="wa_fines_rate"
                                class="oe_inline"
                                required="group_enable_fines_on_wa"
                            /> per day
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
