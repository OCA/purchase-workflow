<odoo>
    <record id="view_purchase_configuration" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.purchase - purchase_order_approved</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase_stock.res_config_settings_view_form_purchase"
        />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting
                    id="purchase_approve_active"
                    company_dependent="1"
                    help="Require second approval for purchase orders as company policy (otherwise it can be set per supplier)"
                >
                    <field name="purchase_approve_active" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
