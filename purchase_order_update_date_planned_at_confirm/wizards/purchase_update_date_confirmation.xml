<odoo>
    <record model="ir.ui.view" id="purchase_update_date_confirmation_form_view">
        <field name="model">purchase.update.date.confirmation</field>
        <field name="arch" type="xml">
            <form string="Purchase Update Date Confirmation">
                <group>
                    <field name="purchase_order_id" />
                    <field name="current_date_planned" />
                </group>
                <footer>
                    <button
                        name="doit"
                        string="Confirm with that date"
                        class="btn-primary"
                        type="object"
                    />
                    <button
                        string="Confirm without that date"
                        class="btn-default"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record
        model="ir.actions.act_window"
        id="purchase_update_date_confirmation_act_window"
    >
        <field name="name">Purchase Update Date Confirmation</field>
        <field name="res_model">purchase.update.date.confirmation</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
</odoo>
