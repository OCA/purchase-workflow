<odoo>
    <!-- View : computed.purchase.order -->
    <record id="view_computed_purchase_order_form" model="ir.ui.view">
        <field name="name">computed.purchase.order.form</field>
        <field name="model">computed.purchase.order</field>
        <field name="arch" type="xml">
            <form name="Computed Purchase Order" disable_autofocus="1">
                <header>
                    <button
                        name="make_order"
                        invisible="state != 'draft'"
                        string="Make Purchase Order"
                        type="object"
                        class="oe_highlight"
                    />
                    <button
                        name="open_update_products"
                        string="Update Products"
                        type="object"
                        class="oe_highlight"
                        invisible="not products_updated"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,done,canceled"
                        readonly="1"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_inline oe_stat_button"
                            string="Order Lines"
                            type="object"
                            name="action_view_order_lines"
                            icon="fa-book"
                        />
                    </div>
                    <h1>
                        <field name="name" class="oe_inline" nolabel="1" />
                    </h1>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field
                                name="purchase_order_id"
                                invisible="state != 'done'"
                            />
                        </group>
                        <group>
                            <field name="incoming_date" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <group>
                        <group string="Get Products" invisible="state != 'draft'">
                            <field name="compute_pending_quantity" />
                            <button
                                name="compute_active_product_stock"
                                type="object"
                                string="Get products and stocks"
                                title="Fetch all active products sold by
                                selected supplier and calculate the available
                                quantities. It ignores inactive or not
                                purchasable products."
                            />
                        </group>
                        <group string="Compute Order">
                            <label for="purchase_target" />
                            <div>
                              <field
                                name="purchase_target"
                                class="oe_inline"
                                readonly="state != 'draft'"
                            />
                                &amp;nbsp;
                              <field
                                name="target_type"
                                class="oe_inline"
                                readonly="state != 'draft'"
                            />
                              <br />
                              <button
                                name="compute_purchase_quantities"
                                type="object"
                                string="Compute Purchase Quantities"
                                invisible="state != 'draft'"
                                title="Compute the optimal purchase quantities
                                of selected products according to the
                                objective."
                            />
                          </div>
                        </group>
                    </group>
                    <group string="Result">
                        <group>
                            <field name="computed_amount" />
                            <field name="package_qty_count" />
                            <field name="lines_with_qty_count" readonly="1" />
                        </group>
                        <group>
                            <field name="computed_duration" />
                        </group>
                    </group>
                    <notebook>
                        <page name="orderlines" string="Order lines">
                            <button
                                name="sort_lines"
                                type="object"
                                string="Sort lines"
                                groups="base.group_no_one"
                            />
                            <field
                                name="line_ids"
                                readonly="state != 'draft'"
                                options="{'reload_on_button': true}"
                            >
                                <list
                                    decoration-warning="state == 'updated'"
                                    decoration-info="state == 'new'"
                                    editable="bottom"
                                >
                                    <field
                                        name="product_code"
                                        string="Supplier Product Code"
                                    />
                                    <field name="product_id" readonly="1" />
                                    <field name="qty_available" string="On hand" />
                                    <field name="incoming_qty" string="Incoming" />
                                    <field
                                        name="displayed_average_consumption"
                                        string="Avg. Consumption"
                                        readonly="1"
                                    />
                                    <field
                                        name="uom_id"
                                        string="UoM"
                                        groups="uom.group_uom"
                                    />
                                    <field name="stock_duration" />
                                    <field
                                        name="purchase_qty_package"
                                        readonly="cpo_state != 'draft'"
                                    />
                                    <field name="package_qty" readonly="1" />
                                    <field name="purchase_qty" readonly="1" />
                                    <field name="product_price" readonly="1" />
                                    <field name="discount" readonly="1" />
                                    <field name="price_policy" readonly="1" />
                                    <field name="shelf_life" readonly="1" />
                                    <field name="virtual_duration" readonly="1" />
                                    <field name="subtotal" readonly="1" />
                                    <field name="state" widget="badge" readonly="1" />
                                    <button
                                        name="unlink_psi"
                                        invisible="state not in ('up_to_date', 'updated') or cpo_state != 'draft'"
                                        type="object"
                                        icon="fa-close"
                                        title="If you click this button,
                                        it means you don't want to buy this
                                        product to this supplier anymore.
                                        The supplier will thus be removed from
                                        the product form."
                                    />
                                    <button
                                        name="create_psi"
                                        invisible="state != 'new' or cpo_state != 'draft'"
                                        type="object"
                                        icon="fa-plus-square"
                                        title="If you click this button,
                                        it means you want to buy this product
                                        to this supplier regularly.
                                        The supplier will thus be added to
                                        the product form."
                                    />
                                    <button
                                        name="update_psi"
                                        invisible="state != 'updated'"
                                        type="object"
                                        icon="fa-upload"
                                        title="Save the changes."
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_computed_purchase_order_tree" model="ir.ui.view">
        <field name="name">computed.purchase.order.tree</field>
        <field name="model">computed.purchase.order</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="state == 'canceled'"
                decoration-info="state == 'draft'"
            >
                <field name="name" />
                <field name="partner_id" />
                <field name="incoming_date" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_computed_purchase_order_search" model="ir.ui.view">
        <field name="name">computed.purchase.order.search</field>
        <field name="model">computed.purchase.order</field>
        <field name="arch" type="xml">
            <search string="Search Purchase Order">
                <field name="name" />
                <field name="partner_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="state" />
                <filter
                    icon="terp-document-new"
                    name="draft"
                    string="Draft"
                    domain="[('state','=','draft')]"
                    help="Computations in draft state"
                />
                <filter
                    icon="terp-check"
                    name="done"
                    string="Converted"
                    domain="[('state','=','done')]"
                    help="Computations already converted into purchase
                              orders"
                />
            </search>
        </field>
    </record>

    <record id="view_computed_purchase_order_form_update_products" model="ir.ui.view">
        <field name="name">computed.purchase.order.form</field>
        <field name="model">computed.purchase.order</field>
        <field name="priority" eval="999" />
        <field name="arch" type="xml">
            <form name="Update Products">
                <field name="line_updated_ids" readonly="state != 'draft'">
                    <list
                        string="Computed purchase order lines"
                        editable="bottom"
                        create="0"
                        delete="0"
                        decoration-warning="state == 'updated'"
                        decoration-info="state == 'new'"
                    >
                        <field name="product_id" readonly="1" />
                        <field
                            name="product_code"
                            string="Supplier Product Code"
                            readonly="cpo_state != 'draft'"
                        />
                        <field
                            name="product_name"
                            string="Supplier Product Name"
                            readonly="cpo_state != 'draft'"
                        />
                        <field name="product_price" readonly="cpo_state != 'draft'" />
                        <field name="price_policy" readonly="cpo_state != 'draft'" />
                    </list>
                </field>
                <footer>
                    <button string="Apply" type="object" name="btn_update_products" />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_view_update_products" model="ir.actions.act_window">
        <field name="name">Update Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">computed.purchase.order</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_computed_purchase_order_form_update_products" />
        <field name="target">new</field>
    </record>
    <record id="action_view_computed_purchase_order_tree" model="ir.actions.act_window">
        <field name="name">Computed Purchase Order</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">computed.purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
            Click to begin a computed purchase order.
          </p>
            <p>
            This tool will allow you to calculate your needs according to the
            stock and average consumption of your products and the purchase
            objective defined against the supplier.
          </p>
        </field>
    </record>

    <menuitem
        id="menu_computed_purchase_order"
        parent="purchase.menu_procurement_management"
        sequence="1"
        action="action_view_computed_purchase_order_tree"
    />
</odoo>
