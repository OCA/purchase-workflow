<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="purchase_order_form_package">
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="before">
                <field name="product_qty_package" optional="show" />
                <field name="package_qty" optional="show" />
                <field name="indicative_package" column_invisible="1" />
            </xpath>
            <xpath expr="//field[@name='price_unit']" position="after">
                <field name="price_policy" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
