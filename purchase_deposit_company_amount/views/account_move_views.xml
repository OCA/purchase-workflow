<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.view.form.company.amount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="allow_company_amount" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']"
                position="after"
            >
                <field
                    name="company_amount"
                    optional="hide"
                    attrs="{'column_invisible': [('parent.allow_company_amount', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
